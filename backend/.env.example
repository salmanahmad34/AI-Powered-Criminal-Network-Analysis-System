# ============================================
# CRIMEGRAPH AI — Environment Configuration Template
# ============================================
# Copy this file to .env and fill in real credentials locally.
# NEVER commit real credentials to version control.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database Credentials (Placeholders Only)
DATABASE_URL=
POSTGRES_PASSWORD=

# Neo4j Credentials (Placeholders Only)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Redis Credentials (Placeholders Only)
REDIS_URL=
REDIS_PASSWORD=

# JWT Secrets (Placeholders Only)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# AI Provider API Keys (Placeholders Only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODEL=z-ai/glm-5.2:free
