# ============================================
# CRIMEGRAPH AI — Environment Configuration Example
# ============================================
# Copy this file to .env and fill in your local values.
# NEVER commit .env or any secret keys to version control.

# --- General ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- PostgreSQL ---
DATABASE_URL=postgresql://user:password@localhost:5432/crimegraph
POSTGRES_PASSWORD=your_postgres_password_here

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# --- Redis ---
REDIS_URL=redis://:your_redis_password_here@localhost:6379
REDIS_PASSWORD=your_redis_password_here

# --- JWT Secrets ---
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# --- AI Service & Provider API Keys ---
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODEL=z-ai/glm-5.2:free

# --- File Upload ---
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
